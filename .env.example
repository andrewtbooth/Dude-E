# Copy to `.env.local` and fill in. NEVER commit the filled-in file —
# this repository is public.

# --- Anthropic ---------------------------------------------------------------
# Required. Used server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Classification model.
# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
# The prompt is tuned against Opus 5; the GRI discipline degrades on smaller
# models, so treat anything else as a trial setting rather than a deployment
# choice. Whichever is set is stamped onto every analysis and every exported
# determination, so an artifact produced by a cheap run says so on its face.
CLASSIFIER_MODEL=claude-opus-5

# Reasoning effort for the classification agent.
# low | medium | high | xhigh | max
# `max` is the most thorough and the most expensive/slowest. See README
# "Tuning cost vs. depth" before changing.
#
# Only Opus 5 and Sonnet 5 accept an effort level. Haiku 4.5 rejects the
# parameter outright and uses a fixed thinking budget instead, so setting this
# alongside CLASSIFIER_MODEL=claude-haiku-4-5 is a startup error rather than a
# silent no-op — a cost dial that appears to work but doesn't is worse than one
# that refuses.
CLASSIFIER_EFFORT=max

# --- Session -----------------------------------------------------------------
# Required. Signing key for the analyst session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# --- Rate limiting -----------------------------------------------------------
# Bounds Anthropic spend on a deployment without an access gate. A budget
# guard, not access control: per-process and in-memory, so it resets on deploy
# and does not coordinate across instances. See docs/DEPLOY.md.
ANALYZE_RATE_LIMIT=10
ANALYZE_RATE_WINDOW_MINUTES=15

# --- Database ----------------------------------------------------------------
# Audit log of determinations. SQLite by default; the schema is
# Postgres-portable when the team outgrows a single file.
DATABASE_URL=file:./prisma/dude-e.db

# --- HTSUS data --------------------------------------------------------------
# Where `npm run sync:htsus` writes revision snapshots and the FTS index.
HTSUS_DATA_DIR=./data/htsus

# Override the USITC base URL only if you are proxying it.
USITC_BASE_URL=https://hts.usitc.gov/reststop

# Where Census publishes the Schedule B editions. Each year lives at
# <base>/<year>/exp-code.txt. Override only if you are mirroring or proxying it;
# the edition year itself is discovered, not configured.
CENSUS_SCHEDULE_B_BASE=https://www.census.gov/foreign-trade/schedules/b

# --- Replay (development only) ----------------------------------------------
# Path to a recorded run to serve instead of calling the API. Lets you exercise
# the question loop, selection, determination recording, PDF export and history
# without spending anything. Ignored in production builds; every run it yields
# is stamped `replay:<model>` so any artifact built from one says so.
#   npx tsx scripts/dev/try-classify.ts --record data/cassettes/x.json "..."
# CLASSIFIER_REPLAY=data/cassettes/x.json

# Per-event pacing for a replay, so the SSE path is exercised rather than
# skipped. Set to 1 for an instant replay in scripts.
CLASSIFIER_REPLAY_DELAY_MS=120
