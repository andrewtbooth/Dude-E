# === SECRETS =================================================================
# This repository is PUBLIC. Nothing below may ever be committed.
.env
.env.*
!.env.example

# === LOCAL DATA ==============================================================
# Audit database contains analyst identities and customer part numbers.
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm
*.sqlite
*.sqlite3

# Everything under data/, wholesale.
#
# Four subdirectories used to be listed individually — htsus/ (snapshots and
# the derived FTS index, hundreds of MB, regenerable via `npm run sync:htsus`),
# raw/ (hand-downloaded tariff exports), pdf/ (generated determinations) and
# cassettes/ (recorded runs). Everything the project has ever put here is
# either large and regenerable or carries the sensitivity of whatever was
# classified: a part-number cassette holds the part number and everything the
# web research turned up about it.
#
# But naming four subdirectories meant `data/notes.txt`, or any new
# subdirectory, was committable — while CLAUDE.md and the README both said
# "data/ is gitignored". In a public repository whose first rule is "never
# commit a customer part number", the protection has to be at least as wide as
# the sentence describing it. Ignore the directory, not a list of its children.
/data/
verify-e2e.pdf

# === BUILD ===================================================================
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# === TOOLING =================================================================
.DS_Store
*.log
npm-debug.log*
coverage/
.vitest/
.eslintcache
prisma/generated/

# Eval runs and team-supplied cases. Cases can contain customer part numbers
# and product descriptions, and this repository is public — only the seed set,
# which is constructed from published tariff text, is committed.
/eval/runs/
/eval/*.local.jsonl

# Throwaway SQLite files created by scripts/dev/browser-e2e.sh
dev-e2e*.db
